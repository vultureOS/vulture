# The Monday test: an ordinary working day, with the real keyboard and pointer, and nothing here knowing where anything is.
# Finishing it unaided is what this whole roadmap is for (see Documentation/Roadmap.md); each milestone adds to it. What it
# can't do yet is listed at the end, as what's still to come.
timeout 60
expect loginwindow: ready
type vulture\r
expect files: ready
pause 1
# ---- Write something down, and keep it.
click button "Text Editor"
expect texteditor: ready
pause 0.5
type Things to do on Monday.
pause 0.5
key meta_l-s
ax-expect button "Save"
type monday.txt\r
ax-gone button "Save"
key meta_l-q
pause 1
# ---- Is it there? Ask the shell.
click button "Terminal"
expect terminal: ready
ax-expect textarea "Terminal"
pause 1
type cat Documents/monday.txt ; echo ; echo monday-$((6*7))\r
ax-expect textarea "Terminal" ~ Things to do on Monday.
ax-expect textarea "Terminal" ~ monday-42
# (A copy to be getting on with, that takes no room; which says what it's for, to anyone who asks.)
type cp -c Documents/monday.txt Documents/monday-draft.txt ; xattr -w org.example.for draft Documents/monday-draft.txt ; xattr -p org.example.for Documents/monday-draft.txt\r
ax-expect textarea "Terminal" ~ draft
# (And one to take home: on a stick, which comes out again when it's told to.)
plug stick usb-storage bus=usb0.0,drive=stick
expect at /Volumes/STICK
type cp Documents/monday.txt /Volumes/STICK/ ; diskutil eject /Volumes/STICK ; ls /Volumes ; echo stick-is-out\r
ax-expect textarea "Terminal" ~ stick-is-out
key meta_l-q
ax-gone textarea "Terminal"
# ---- Find it again, by what it's called.
key meta_l-spc
expect search: shown
pause 0.3
type monday
ax-expect row "monday.txt"
key esc
ax-gone row "monday.txt"
timeout 60
# ---- Dates and numbers, as they're written in Germany.
key meta_l-spc
expect search: shown
pause 0.3
type settings
pause 1
type \r
expect settings: Appearance
pause 1
click row "Accessibility"
expect settings: Accessibility
ax-expect switch "Reduce motion" = off
click row "Language & Region"
expect settings: Language & Region
ax-expect text "1,234.56"
click popup "Region"
click menuitem "Germany"
ax-expect text "1.234,56"
ax-expect text "4.567,89 €"
key meta_l-q
ax-gone text "1.234,56"
pause 1
click button "Terminal"
expect terminal: ready
ax-expect textarea "Terminal"
pause 1
type date +%A ; echo region-$LANG\r
ax-expect textarea "Terminal" ~ region-de_DE.UTF-8
key meta_l-q
ax-gone textarea "Terminal"
# ---- And back.
key meta_l-spc
expect search: shown
pause 0.3
type settings
pause 1
type \r
expect settings: Appearance
pause 1
click row "Language & Region"
expect settings: Language & Region
click popup "Region"
click menuitem "United States"
ax-expect text "1,234.56"
key meta_l-q
ax-gone text "1,234.56"
pause 1
# ---- A note in a hurry, put right along the way, with a word held down for its accent.
click button "Text Editor"
expect texteditor: ready
ax-expect textarea "Document"
pause 0.5
type teh caf
hold e 1000
ax-expect row "é"
key 2
type  omw 
ax-expect textarea "Document" ~ The café On my way!
key meta_l-q
ax-expect button "Don’t Save"
click button "Don’t Save"
ax-gone textarea "Document"

# ---- And leave.
click menuitem "Logo"
click menuitem "Log Out"
expect loginwindow: ready
# Still to come, each with its milestone: read the mail (M33), open a PDF (M30), add a meeting to the calendar (M31), browse
# (M40), play music (M34).
