# The desktop, from the login window on: a person's first minutes with it, done with
# the real keyboard and pointer. Each screenshot is compared with Tests/UI/Golden.
expect loginwindow: ready
pause 0.5
screenshot login.png
# The wrong password first.
type nothing\r
expect loginwindow: incorrect password
pause 0.5
screenshot login-wrong.png
type vulture\r
expect finder: ready
pause 2
screenshot desktop.png
# The application's File menu, and the system's.
pointer 3072 491
pause 0.3
button left down
pause 0.2
button left up
pause 0.6
screenshot menu-file.png
pointer 512 491
pause 0.6
screenshot menu-system.png
pointer 16000 24000
pause 0.2
button left down
pause 0.2
button left up
pause 0.6
# Spotlight: a word, then what it found, by Return.
key meta_l-spc
expect spotlight: shown
pause 0.3
type system
pause 1
screenshot spotlight.png
type \r
expect settings: Appearance
pause 1
screenshot settings.png
# Dark, then a wallpaper.
pointer 26060 9011
pause 0.3
button left down
pause 0.2
button left up
pause 1
screenshot settings-dark.png
pointer 6656 6963
pause 0.3
button left down
pause 0.2
button left up
expect settings: Wallpaper
pause 0.5
pointer 18200 10977
pause 0.3
button left down
pause 0.2
button left up
pause 1.5
screenshot wallpaper.png
