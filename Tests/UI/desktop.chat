key ctrl-left
pause 1
# Launchpad.
pointer 14670 31070
pause 0.5
button left down
pause 0.2
button left up
expect launchpad: shown
pause 1
screenshot launchpad.png
key esc
pause 1
# Settings goes away; Finder, by its own folders.
pointer 16000 24000
pause 0.2
button left down
pause 0.2
button left up
pause 0.3
