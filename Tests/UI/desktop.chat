# The desktop, from the login window on: a person's first minutes with it, done with
# the real keyboard and pointer. Each screenshot is compared with Tests/UI/Golden.
expect loginwindow: ready
pause 0.5
screenshot login.png
# The wrong password first.
type nothing\r
expect loginwindow: incorrect password
pause 0.5
screenshot login-wrong.png
type vulture\r
expect files: ready
pause 2
screenshot desktop.png
# The application's File menu, and the system's.
pointer 3072 491
pause 0.3
button left down
pause 0.2
button left up
pause 0.6
screenshot menu-file.png
pointer 512 491
pause 0.6
screenshot menu-system.png
pointer 16000 24000
pause 0.2
button left down
pause 0.2
button left up
pause 0.6
# Search: a word, then what it found, by Return.
key meta_l-spc
expect search: shown
pause 0.3
type settings
pause 1
screenshot search.png
type \r
expect settings: Appearance
pause 1
screenshot settings.png
# Dark, then a wallpaper.
pointer 26060 7536
pause 0.3
button left down
pause 0.2
button left up
pause 1
screenshot settings-dark.png
click row "Wallpaper"
expect settings: Wallpaper
pause 0.5
pointer 18200 9502
pause 0.3
button left down
pause 0.2
button left up
pause 1.5
screenshot wallpaper.png
# Back to the first wallpaper and to light.
pointer 12800 9502
pause 0.3
button left down
pause 0.2
button left up
pause 0.5
click row "Appearance"
expect settings: Appearance
pause 0.5
pointer 25100 7536
pause 0.3
button left down
pause 0.2
button left up
pause 1
# A notification, and where they are kept: Settings' pane for them, and one posted from Terminal.
click row "Notifications"
expect settings: Notifications
pause 0.5
screenshot settings-notifications.png
click button "Terminal"
expect terminal: ready
pause 1
type notification -a Settings -t "It works" -m "This is how notifications look."\r
expect notification: It works
pointer 16000 9000
pause 0.8
screenshot notification.png
pointer 30900 491
pause 0.3
button left down
pause 0.2
button left up
expect notifications: center shown
pause 0.6
screenshot notification-list.png
key esc
pause 0.5
key meta_l-q
pause 1
# Quick Settings.
pointer 28800 491
pause 0.3
button left down
pause 0.2
button left up
pause 0.6
screenshot quick-settings.png
pointer 16000 24000
pause 0.2
button left down
pause 0.2
button left up
pause 0.6
# Overview, and a new space: the row of them opens at the top, and its "+" adds one.
key ctrl-up
pause 1
screenshot overview.png
pointer 16000 0
pause 0.6
ax-expect button "Add Desktop"
click button "Add Desktop"
pause 0.6
ax-expect button "Desktop 2"
screenshot overview-spaces.png
pointer 26000 28000
pause 0.2
button left down
pause 0.2
button left up
pause 1
key ctrl-right
pause 1
screenshot second-space.png
key ctrl-left
pause 1
# Launcher.
pointer 10977 31070
pause 0.5
button left down
pause 0.2
button left up
expect launcher: shown
pause 1
screenshot launcher.png
key esc
pause 1
# Settings goes away; Files, by its own folders.
pointer 16000 24000
pause 0.2
button left down
pause 0.2
button left up
pause 0.3
key meta_l-q
pause 1
pointer 13619 7332
pause 0.3
button left down
pause 0.1
button left up
pause 0.1
button left down
pause 0.1
button left up
pause 1
screenshot files-documents.png
pointer 25958 4301
pause 0.3
button left down
pause 0.2
button left up
pause 0.6
type Notes\r
pause 1
screenshot files-new-folder.png
pointer 24934 4301
pause 0.3
button left down
pause 0.2
button left up
pause 0.6
screenshot files-list.png
# Into the Dock with the yellow light, and back.
pointer 5478 3850
pause 0.3
button left down
pause 0.2
button left up
pause 1
screenshot minimized.png
pointer 22528 31070
pause 0.5
button left down
pause 0.2
button left up
pause 1
screenshot restored.png
# Out, and the login window is back.
pointer 512 491
pause 0.3
button left down
pause 0.2
button left up
pause 0.6
screenshot before-log-out.png
click menuitem "Log Out vulture…"
expect loginwindow: ready
pause 1
screenshot logged-out.png
