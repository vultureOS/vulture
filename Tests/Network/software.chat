# Software, against a repository: get an application, run it, take it off again.
expect loginwindow: ready
pause 0.5
type vulture\r
expect files: ready
pause 2
key meta_l-w
pause 0.5
key meta_l-spc
expect search: shown
pause 0.3
type software
pause 1
type \r
expect software: ready
pause 1.5
screenshot installed.png
pointer 8110 7943
pause 0.3
button left down
pause 0.2
button left up
expect software:  done
pause 1
screenshot available.png
pointer 25477 6947
pause 0.3
button left down
pause 0.2
button left up
expect software: hello done
pause 1
screenshot available-got.png
pointer 8110 6790
pause 0.3
button left down
pause 0.2
button left up
pause 1
screenshot installed-with-hello.png
# It runs.
pointer 25247 17432
pause 0.3
button left down
pause 0.2
button left up
expect hello: ready
pause 1
screenshot hello.png
key meta_l-q
pause 1
# A package that isn't what its index says: an alert, and nothing installed.
pointer 8110 7943
pause 0.3
button left down
pause 0.2
button left up
pause 0.8
pointer 25395 9568
pause 0.3
button left down
pause 0.2
button left up
expect software: tampered failed
pause 1
screenshot tampered.png
type \r
pause 0.6
# And off it comes again.
pointer 8110 6790
pause 0.3
button left down
pause 0.2
button left up
pause 0.8
pointer 23429 17432
pause 0.3
button left down
pause 0.2
button left up
expect software: hello done
pause 1
screenshot removed.png
key meta_l-q
pause 1
# Settings says what the network is.
key meta_l-spc
expect search: shown
pause 0.3
type settings
pause 1
type \r
expect settings: Appearance
pause 1
pointer 6656 9257
pause 0.3
button left down
pause 0.2
button left up
expect settings: Network
pause 0.8
screenshot settings-network.png
