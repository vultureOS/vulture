# A text login on the console, as a person does it (Meta/run.sh --chat):
# logging in, a pipeline, a job suspended with ^Z and brought back with fg,
# logging out (vlaunchd starts getty again), logging in again, and powering
# off with sudo.

expect login: 
send vulture\r
expect Password:
send vulture\r
expect Welcome to vultureOS.
expect vulture@vulture ~ % 

send ls -l /System/Library | grep Kernels | wc -l\r
expect        1
expect vulture@vulture ~ % 

send sleep 30\r
pause 1
send \x1a
expect vsh: suspended  sleep 30
expect vulture@vulture ~ % 
send jobs\r
expect [1]  + suspended  sleep 30
expect vulture@vulture ~ % 
send fg\r
expect [1]  + continued  sleep 30
pause 1
send \x03
expect vulture@vulture ~ % 

send exit\r
expect login: 
send vulture\r
expect Password:
send vulture\r
expect Last login: 
expect  on console
expect vulture@vulture ~ % 

# What vlaunchd is looking after, and asking it to look after something else.
send launchctl list | head -1\r
expect PID	Status	Label
expect vulture@vulture ~ % 
send launchctl list no.such.job\r
expect Could not find service "no.such.job"
expect vulture@vulture ~ % 
send launchctl stop no.such.job\r
expect Not privileged to stop service
expect vulture@vulture ~ % 
send printf '{"Label":"test.sleeper","ProgramArguments":["/bin/sleep","600"],"RunAtLoad":true}' > /tmp/sleeper.plist\r
expect vulture@vulture ~ % 
send sudo launchctl load /tmp/sleeper.plist\r
expect Password:
send vulture\r
expect vulture@vulture ~ % 
send launchctl list test.sleeper | grep -c PID\r
expect 1
expect vulture@vulture ~ % 
send sudo launchctl load /tmp/sleeper.plist\r
expect service already loaded
expect vulture@vulture ~ % 
send sudo launchctl unload /tmp/sleeper.plist\r
expect vulture@vulture ~ % 
pause 1
send launchctl list test.sleeper\r
expect Could not find service "test.sleeper"
expect vulture@vulture ~ % 

# An editor, and what it wrote.
send vi /tmp/note.txt\r
pause 1
send ihello from vi\x1b
pause 1
send :wq\r
expect vulture@vulture ~ % 
send cat /tmp/note.txt\r
expect hello from vi
expect vulture@vulture ~ % 

# A manual page, set for the width of what's reading it.
send man launchctl | head -6\r
expect LAUNCHCTL(1)
expect launchctl - talk to the launch daemon
expect vulture@vulture ~ % 
send man no-such-page\r
expect No manual entry for no-such-page
expect vulture@vulture ~ % 

# What's mounted, and mounting.
send mkdir /tmp/space\r
expect vulture@vulture ~ % 
send sudo mount -t tmpfs tmpfs /tmp/space\r
expect vulture@vulture ~ % 
send sudo sh -c 'echo inside > /tmp/space/file'\r
expect vulture@vulture ~ % 
send cat /tmp/space/file\r
expect inside
expect vulture@vulture ~ % 
send sudo umount /tmp/space\r
expect vulture@vulture ~ % 
send ls /tmp/space | wc -l\r
expect 0
expect vulture@vulture ~ % 

send sudo poweroff\r
expect vlaunchd: powering off
