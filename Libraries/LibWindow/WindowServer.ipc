// PranaWindowServer (com.vulture.windowserver): windows, in points; surfaces and
// damage, in pixels (points times the screen's scale).
endpoint WindowServer
{
    // A client's first message: where its events go. Answers the screen's size
    // in points, its scale, and the appearance ("Light" or "Dark").
    connect(Port events) => (i32 error, i32 width, i32 height, i32 scale, String appearance)

    create_window(String title, i32 x, i32 y, i32 width, i32 height, u32 flags) => (i32 error, u32 window)
    destroy_window(u32 window) =|
    set_title(u32 window, String title) =|
    set_frame(u32 window, i32 x, i32 y, i32 width, i32 height) =|
    show(u32 window, bool visible) =|
    // Makes it the active window, in front.
    activate(u32 window) =|
    set_level(u32 window, i32 level) =|
    // In points; negative for the theme's.
    set_corner_radius(u32 window, i32 radius) =|
    // In points; how far down the title bar reaches (0 for the theme's height).
    set_title_bar(u32 window, i32 height) =|
    // While pressed in the window: the rest of this press moves the window.
    begin_move(u32 window) =|
    // Every pointer event goes to this window until it lets go, wherever the pointer
    // is (a menu closing on a click elsewhere). Ends any press underway.
    grab_pointer(u32 window, bool grab) =|
    // The pointer's shape while over this window: see <LibWindow/Protocol.h>.
    set_cursor(u32 window, i32 shape) =|
    // "Light" or "Dark", for everyone.
    set_appearance(String name) => (i32 error)
    set_keyboard_layout(String identifier) => (i32 error)

    // The window's pixels: shared memory holding two buffers of this size, one
    // after the other, premultiplied BGRA. One is shown; the client draws in
    // the other, then presents it.
    set_surface(u32 window, Port memory, i32 width, i32 height) => (i32 error)
    // This buffer is now the one shown; this rectangle of it changed. Once it
    // is on screen the client hears `presented`, and may use the other.
    present(u32 window, u32 buffer, i32 x, i32 y, i32 width, i32 height) =|

    // A layer: something over the window's own surface, or in another layer (`parent`, or 0), that the server moves and fades
    // and animates by itself. It has a surface as the window does, if it wants pixels.
    create_layer(u32 window, u32 parent) => (i32 error, u32 layer)
    set_layer_surface(u32 window, u32 layer, Port memory, i32 width, i32 height) => (i32 error)
    // Changes to this window's layers, as an array of LayerChange (see <LibWindow/Protocol.h>), all of which are on the screen in
    // the same frame. Once that's happened, it hears `layers_presented` with this serial.
    commit_layers(u32 window, u32 serial, ByteBuffer changes) =|
    // For tests and tools: only root may. What each frame has shown of a layer with Logged set, as an array of a double (seconds
    // since the animation started) and four floats. The log starts again.
    layer_frame_log(u32 window, u32 layer) => (i32 error, ByteBuffer log)

    // Parts of the window with a material behind them (where its pixels are
    // not opaque, the blurred backdrop shows): x, y, width, height (points, from
    // the window's top-left), material and corner radius (points), for each.
    set_materials(u32 window, Vector<i32> regions) =|

    // While pressed in the window: drags this data, with `image` (another of its
    // windows) following the pointer, until the button is let go. Windows under it
    // hear `drag`; if the last one says accept_drop(true), it gets the data.
    begin_drag(u32 window, u32 image, String type, ByteBuffer data) =|
    accept_drop(u32 window, bool accepted) =|

    // Who this program is, for the Dock and the menu bar: an application, as opposed to
    // a part of the desktop itself. Its menus, as JSON (see LibUI's Application).
    set_application(String name, String identifier) =|
    set_menus(String menus) =|

    // The desktop's own: hearing of every application and window (shell_state), telling
    // applications what to do, and what they may not do for themselves.
    subscribe_shell() =|
    choose_menu_item(i32 pid, u32 item) =|
    activate_application(i32 pid) =|
    hide_application(i32 pid, bool hidden) =|
    quit_application(i32 pid) =|
    // Its own, or if this is the desktop, anyone's.
    arrange_window(u32 window, i32 arrangement) =|
    // Everyone else out of the way, or everyone back.
    hide_others(bool hidden) =|
    // A Space to itself, or back. Its own, or if this is the desktop, anyone's.
    set_full_screen(u32 window, bool full) =|
    toggle_full_screen(u32 window) =|
    // Full screen on one side, and a choice of what's to go on the other.
    tile_in_split_view(u32 window, bool on_left) =|
    // Whether a window goes to where it's dragged, with Option or without, and has margins when it gets there.
    set_tiling(bool by_edges, bool to_menu_bar, bool with_option, bool margins) =|
    // Another window takes over where this one is: a tab being chosen. All of it: frame, Space, tile, full screen.
    take_place_of(u32 window, u32 other) =|
    set_hot_corners(i32 top_left, i32 top_right, i32 bottom_left, i32 bottom_right) =|
    // Clicking the wallpaper uncovers the desktop, or only does in Stage.
    set_click_wallpaper(bool reveals) =|
    // From the desktop's own window: a press on it that wasn't on anything there, as one on the wallpaper is.
    wallpaper_clicked() =|
    // One application's windows at a time, with the others in a strip down the side.
    set_stage(bool on) =|
    // This client's the one to show the green button's menu: see `window_menu_wanted`.
    show_window_menus() =|
    // Its own: as the yellow and green lights do.
    minimize(u32 window) =|
    zoom(u32 window) =|
    // Any window: brought back if minimized, brought to its space, and made active.
    activate_window(u32 window) =|
    // Where minimized windows go to (points on the screen): where the Dock has them.
    set_minimize_target(i32 x, i32 y) =|
    // What a zoomed window must leave clear, in points from each edge.
    set_work_area(i32 top, i32 left, i32 bottom, i32 right) =|
    // The system-wide keys: this client hears them, and nobody else.
    register_hotkey(u16 code, u32 modifiers) =|
    // Where pointer events land, in points from its top-left: elsewhere they go to what
    // is below. An odd-shaped window's, as the Dock's.
    set_input_region(u32 window, i32 x, i32 y, i32 width, i32 height) =|
    // All of the displays, as an array of DisplayRecord (see <LibWindow/Protocol.h>).
    displays() => (ByteBuffer records, bool mirrored, i32 outputs)
    // Where a display goes, in points from the main one, and how big it's to look. Everyone hears `displays_changed`.
    set_display(i32 output, i32 x, i32 y, i32 width, i32 height) => (i32 error)
    // All of them showing the main one.
    set_mirroring(bool mirrored) => (i32 error)
    // Night Shift: how warm, from 0 (not at all) to 100.
    set_warmth(i32 percent) => (i32 error)
    // Whether content follows the fingers, as on a phone, or the other way, as with a scroller.
    set_natural_scrolling(bool natural) =|
    // A touch of a trackpad counts as a click.
    set_tap_to_click(bool tap) =|
    // How far a mouse moves the pointer: 100 is one to one, from 25 to 400.
    set_pointer_speed(i32 percent) =|
    // Things that would move, don't, for everyone: they change at once, or fade.
    set_reduce_motion(bool reduced) =|
    // By name: see /System/Library/Themes/Wallpapers.json.
    set_wallpaper(String name) => (i32 error)
    // Desktops, and all windows spread out over them.
    set_overview(bool shown) =|
    switch_space(i32 space) =|

    // For tests and tools: only root may. As if the pointer moved here (points), at this time on the monotonic clock in
    // microseconds, or 0 for now.
    inject_pointer(i32 x, i32 y, u32 buttons, u64 sent_at) =|
    // `resize_mismatches`: frames shown with a window being resized by hand at a size its contents weren't.
    statistics() => (u64 frames, u64 compose_microseconds, u64 flush_microseconds, u64 pixels, u64 material_microseconds, u64 resize_mismatches)
    // The answer to `ping`.
    pong(u32 serial) =|
    // The pointer's shape now, and how far round it is, if it goes round.
    cursor_shape() => (i32 shape, i32 turn)
    // For tests and tools: only root may. As if everything on the screen had changed.
    damage_everything() =|
    // From the pointer moving to the window it's dragging being on the screen, since this was last asked: how many were
    // timed, the 99th percentile and the worst, in microseconds. It's as far as this can see: the display's own latency
    // comes after. (Asked by the one measuring: the counts start again.)
    input_latency() => (u64 count, u64 p99_microseconds, u64 worst_microseconds)
    // The screen as it is now, as a PNG. All of the desktop; or just this much of it, in points, if the width isn't 0. Only for one that's
    // been allowed to, as `Connection::capture_screen` sees to: others get EPERM, and a line in the log.
    capture() => (i32 error, ByteBuffer png)
    capture_area(i32 x, i32 y, i32 width, i32 height) => (i32 error, ByteBuffer png)
    // Frames of the screen, in this memory, for as long as it goes on: `recorded_frame` says when there's another, and it has to say
    // `recording_ready` before it's given the next. Only for one that's been allowed to.
    start_recording(Port memory, i32 x, i32 y, i32 width, i32 height) => (i32 error)
    recording_ready() =|
    stop_recording() =|
    // What is on the screen, in words. Only root may ask. Every application with a window hears of it, and answers
    // with publish_accessibility as it gets to it; one that's stuck never does. `accessibility` says what has come in so
    // far: the screen and its windows, front to back, as JSON, with each answer that came.
    request_accessibility() => (i32 error, u32 generation)
    publish_accessibility(u32 generation, String json) =|
    accessibility(u32 generation) => (i32 error, u32 asked, u32 answered, String json)
}

endpoint WindowClient
{
    // kind: see <LibWindow/Protocol.h>. Position in points from the window's
    // top-left.
    mouse(u32 window, u8 kind, i32 x, i32 y, u32 buttons, u32 modifiers, i32 wheel_x, i32 wheel_y) =|
    key(u32 window, bool pressed, u16 code, u32 modifiers, String text) =|
    resized(u32 window, i32 width, i32 height) =|
    // By the window manager. (Where its owner put it, it knows.)
    moved(u32 window, i32 x, i32 y) =|
    close_requested(u32 window) =|
    activated(u32 window, bool active) =|
    presented(u32 window) =|
    layers_presented(u32 window, u32 serial) =|
    layer_animation_finished(u32 window, u32 layer, u32 tag) =|
    appearance_changed(String name) =|
    motion_changed(bool reduced) =|
    full_screen_changed(u32 window, bool full) =|
    // One that's not for the server to do: see HotCornerAction.
    hot_corner_fired(i32 action) =|
    // The pointer has been waiting over a window's green button. On the screen, in points, where its menu would go.
    window_menu_wanted(u32 window, i32 x, i32 y) =|
    // Asked for by nobody in particular: see `displays`. The main one's size is what `connect` said it was, if it's changed.
    displays_changed(i32 main_width, i32 main_height) =|
    // phase: see <LibWindow/Protocol.h>. The data comes only with Dropped.
    drag(u32 window, u8 phase, i32 x, i32 y, String type, ByteBuffer data) =|
    // To the window it started from.
    drag_finished(u32 window, bool accepted) =|
    // What the program's menu bar says it has chosen. Asked to quit.
    menu_item_chosen(u32 item) =|
    quit_requested() =|
    // To the desktop: all applications and windows, as JSON, whenever any change.
    shell_state(String json) =|
    hotkey(u16 code, u32 modifiers) =|
    // For publish_accessibility.
    accessibility_requested(u32 generation) =|
    // In the memory it gave start_recording: `width` by `height`, in pixels, on the monotonic clock at this time in microseconds.
    recorded_frame(i32 width, i32 height, u64 time) =|
    // Input has been sent to this program: is it there? It's the event loop that answers, so one that's stuck doesn't.
    ping(u32 serial) =|
}
