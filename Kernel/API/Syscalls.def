/*
 * The system call table, defined once. The kernel builds its dispatcher and
 * LibSystem its numbers from this list: SYSCALL(name, argument count).
 * Numbers are positions in the list, so only ever append.
 *
 * Calling convention (see Documentation/Syscalls.md): on AArch64, SVC #0 with the number in x8 and arguments
 * in x0-x5; the result comes back in x0, a negative errno on failure.
 */

SYSCALL(exit, 1)
SYSCALL(write, 3)
SYSCALL(read, 3)
SYSCALL(open, 3)
SYSCALL(close, 1)
SYSCALL(lseek, 3)
SYSCALL(fstat, 2)
SYSCALL(getpid, 0)
SYSCALL(getppid, 0)
SYSCALL(gettid, 0)
SYSCALL(fork, 0)
SYSCALL(execve, 3)
SYSCALL(waitpid, 3)
SYSCALL(kill, 2)
SYSCALL(sigaction, 3)
SYSCALL(sigprocmask, 3)
SYSCALL(sigreturn, 0)
SYSCALL(mmap, 6)
SYSCALL(munmap, 2)
SYSCALL(mprotect, 3)
SYSCALL(sched_yield, 0)
SYSCALL(clock_gettime, 2)
SYSCALL(nanosleep, 2)
SYSCALL(power_off, 0)
SYSCALL(stat, 2)
SYSCALL(dup, 1)
SYSCALL(dup2, 2)
SYSCALL(pipe, 2)
SYSCALL(mkdir, 2)
SYSCALL(rmdir, 1)
SYSCALL(unlink, 1)
SYSCALL(rename, 2)
SYSCALL(getcwd, 2)
SYSCALL(chdir, 1)
SYSCALL(getdents, 3)
SYSCALL(fsync, 1)
SYSCALL(ftruncate, 2)
SYSCALL(readlink, 3)
SYSCALL(symlink, 2)
SYSCALL(lstat, 2)
SYSCALL(sync, 0)
SYSCALL(fcntl, 3)
SYSCALL(access, 2)
SYSCALL(setpgid, 2)
SYSCALL(getpgid, 1)
SYSCALL(setsid, 0)
SYSCALL(getsid, 1)
SYSCALL(ioctl, 3)
SYSCALL(getuid, 0)
SYSCALL(geteuid, 0)
SYSCALL(getgid, 0)
SYSCALL(getegid, 0)
SYSCALL(setuid, 1)
SYSCALL(setgid, 1)
SYSCALL(seteuid, 1)
SYSCALL(setegid, 1)
SYSCALL(getgroups, 2)
SYSCALL(setgroups, 2)
SYSCALL(umask, 1)
SYSCALL(chmod, 2)
SYSCALL(fchmod, 2)
SYSCALL(chown, 4)
SYSCALL(fchown, 3)
SYSCALL(link, 2)
SYSCALL(utimensat, 4)
SYSCALL(futimens, 2)
SYSCALL(uname, 1)
SYSCALL(getrandom, 3)
SYSCALL(poll, 3)
SYSCALL(sysctl, 6)
SYSCALL(reboot, 1)
SYSCALL(sigsuspend, 1)
SYSCALL(sigpending, 1)
SYSCALL(alarm, 1)
SYSCALL(pread, 4)
SYSCALL(pwrite, 4)
SYSCALL(port_create, 2)
SYSCALL(port_make_send, 2)
SYSCALL(port_send, 3)
SYSCALL(port_receive, 3)
SYSCALL(port_call, 4)
SYSCALL(bootstrap_port, 2)
SYSCALL(thread_create, 1)
SYSCALL(thread_exit, 2)
SYSCALL(thread_kill, 2)
SYSCALL(futex, 4)
SYSCALL(sigaltstack, 2)
SYSCALL(sigtimedwait, 3)
SYSCALL(shared_memory_create, 2)
SYSCALL(socket, 3)
SYSCALL(bind, 3)
SYSCALL(listen, 2)
SYSCALL(accept, 4)
SYSCALL(connect, 3)
SYSCALL(sendto, 6)
SYSCALL(recvfrom, 6)
